.vercel
node_modules/
data/*.db
data/*.db-shm
data/*.db-wal
.env
*.log
.DS_Store

# Build outputs
dist/
client/dist/

# Package manager locks
package-lock.json
client/package-lock.json

# Local environments
client/.env.local

# Per-tenant Terraform runtime files (state is remote; local files are ephemeral)
data/tenant-terraform/
**/.terraform/
*.tfstate
*.tfstate.*
*.tfplan
*.auto.tfvars.json

# Terraform CLI binary tải về cho validator (87MB) — không commit vào repo
data/terraform-validator/

# Terraform variable files chua bi mat (jwt_secret, session_secret, db_password).
# Giu lai file *.example de biet can khai bao nhung gi.
*.tfvars
*.tfvars.json
!*.tfvars.example

# Private key: KHONG BAO GIO commit. Terraform sinh ra .pem khi provision.
*.pem
*.key
