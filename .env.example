# Use production only on a deployed host. Keep real values in /opt/eaudit/.env
# or a secret manager; a private repository is not a secret store.
NODE_ENV=development
PORT=3001
USE_SQLITE=false
JWT_SECRET=<generate-at-deploy>
SESSION_SECRET=<generate-at-deploy>
ALLOWED_ORIGINS=http://localhost:5173
# GEMINI_API_KEY=<set-only-when-gemini-is-enabled>

# Optional live screen monitor. WebRTC media stays browser-to-browser; Supabase
# only carries private signaling. Keep all values in a managed secret in production.
LIVE_MONITORING_ENABLED=false
# SUPABASE_URL=https://<project-ref>.supabase.co
# SUPABASE_PUBLISHABLE_KEY=<set-locally>
# SUPABASE_REALTIME_PRIVATE_KEY_BASE64=<set-locally>
# SUPABASE_REALTIME_JWT_KEY_ID=<set-locally>
# OPEN_RELAY_CREDENTIALS_URL=https://<set-locally>.metered.live/api/v1/turn/credentials
# OPEN_RELAY_API_KEY=<set-locally>

# Shared AWS SES delivery. AWS_REGION plus all three values below are required.
# SES_FROM_EMAIL=assessments@example.com
# SES_SNS_TOPIC_ARN=arn:aws:sns:ap-southeast-1:123456789012:eproc-ses-events
# SES_CONFIGURATION_SET=eproc-delivery-events

# FSA-CLS assessment data-plane. Leave DATABASE_URL empty for local SQLite
# development (data/eaudit.db). Existing assessment data is retained here.
TENANT_SLUG=fsa-cls
DEFAULT_TENANT_NAME=FSA CLS
DEFAULT_TENANT_CONTACT_EMAIL=admin@fsa-cls.local
DEFAULT_TENANT_DOMAIN=epoc.devfasttrack.com
DEFAULT_TENANT_APP_URL=https://epoc.devfasttrack.com/
# One RDS instance may host all three planes, but the database names must differ.
# DATABASE_URL=postgresql://<db-user>:<url-encoded-db-password>@<db-host>:5432/eaudit

# Global tenant control-plane: admin identities, tenant configuration, Terraform
# jobs and tenant audit events only. Local default: data/control-plane.db.
# In production CONTROL_DATABASE_URL is mandatory and never falls back to DATABASE_URL.
# CONTROL_DATABASE_URL=postgresql://<db-user>:<url-encoded-db-password>@<db-host>:5432/eaudit_control
# CONTROL_SQLITE_PATH=data/control-plane.db
# CONTROL_DB_POOL_MAX=5

# Tenant operational issue log-plane. This does not store candidate violations.
# In production LOG_DATABASE_URL is mandatory and must be separate from both URLs above.
# Local default: data/tenant-logs.db.
# LOG_DATABASE_URL=postgresql://<db-user>:<url-encoded-db-password>@<db-host>:5432/eaudit_fsa_cls_logs
# LOG_SQLITE_PATH=data/tenant-logs.db
# LOG_DB_POOL_MAX=5

# Maintenance database used only by `npm run db:ensure` to create missing
# application databases. The PostgreSQL role needs CONNECT and CREATEDB.
DATABASE_MAINTENANCE_DB=postgres
DB_POOL_MIN=2
DB_POOL_MAX=10

# Comma-separated Secrets Manager ARN allowlist readable by the superadmin control-plane
# host for selected remote tenant log observation. Do not set this on ordinary tenant hosts.
# CONTROL_PLANE_LOG_SECRET_ARNS=arn:aws:secretsmanager:ap-southeast-1:123456789012:secret:eproc-acme

# Initial platform owner (used only when admin_users is empty).
SUPERADMIN_USERNAME=supperadmin
SUPERADMIN_PASSWORD=<set-before-first-production-start>

# Multi-tenant Terraform control plane. Keep disabled on developer machines and
# serverless deployments. Enable only on a trusted, persistent admin worker/host.
TENANT_PROVISIONING_ENABLED=false
TERRAFORM_BIN=terraform
TERRAFORM_STATE_BUCKET=eproc-terraform-state
TERRAFORM_STATE_REGION=ap-southeast-1
TERRAFORM_LOCK_TABLE=eproc-terraform-locks
# TENANT_TERRAFORM_WORKDIR=/opt/eproc/tenant-terraform

# Platform-owned compiler image. Required only when an approved tenant enables
# the Practice Lambda compiler; tenants cannot override this image.
# TENANT_COMPILER_IMAGE_URI=123456789012.dkr.ecr.ap-southeast-1.amazonaws.com/eproc/compiler:v1

# These are written automatically by Terraform on each tenant server.
PRACTICE_COMPILER_MODE=local
# PRACTICE_COMPILER_LAMBDA_ARN=arn:aws:lambda:ap-southeast-1:123456789012:function:eproc-example-compiler
# S3_IDENTITY_BUCKET=eproc-example-identity

# AWS Secrets Manager cho cấu hình ứng dụng. MẶC ĐỊNH TẮT — khi tắt, server đọc
# toàn bộ cấu hình từ file .env này và không gọi AWS.
# Bật lên thì giá trị trong secret GHI ĐÈ các biến cùng tên ở trên, và server sẽ
# DỪNG HẲN nếu không đọc được secret (thay vì chạy tiếp bằng cấu hình cũ).
# Nội dung secret phải là object JSON: {"DATABASE_URL":"...","JWT_SECRET":"..."}
# Khóa được phép nạp: DATABASE_URL, CONTROL_DATABASE_URL, LOG_DATABASE_URL,
# JWT_SECRET, SESSION_SECRET, GEMINI_API_KEY, AWS_ACCESS_KEY_ID,
# AWS_SECRET_ACCESS_KEY, S3_RECORDINGS_BUCKET, SES_FROM_EMAIL, SES_SNS_TOPIC_ARN,
# SES_CONFIGURATION_SET, SUPERADMIN_PASSWORD, LIVE_MONITORING_ENABLED,
# SUPABASE_URL, SUPABASE_PUBLISHABLE_KEY, SUPABASE_REALTIME_PRIVATE_KEY_BASE64,
# SUPABASE_REALTIME_PRIVATE_KEY, SUPABASE_REALTIME_JWT_KEY_ID,
# OPEN_RELAY_CREDENTIALS_URL, OPEN_RELAY_API_KEY.
# IAM role của instance cần secretsmanager:GetSecretValue trên đúng ARN này.
APP_SECRETS_ENABLED=false
# APP_SECRETS_ARN=arn:aws:secretsmanager:ap-southeast-1:123456789012:secret:eproc/app-AbCdEf
# APP_SECRETS_REGION=ap-southeast-1
