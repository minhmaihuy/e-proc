NODE_ENV=development
PORT=3001
JWT_SECRET=replace-with-at-least-32-random-characters
SESSION_SECRET=replace-with-another-random-secret
ALLOWED_ORIGINS=http://localhost:5173

# FSA-CLS assessment data-plane. Leave DATABASE_URL empty for local SQLite
# development (data/eaudit.db). Existing assessment data is retained here.
TENANT_SLUG=fsa-cls
DEFAULT_TENANT_NAME=FSA CLS
DEFAULT_TENANT_CONTACT_EMAIL=admin@fsa-cls.local
DEFAULT_TENANT_DOMAIN=epoc.devfasttrack.com
DEFAULT_TENANT_APP_URL=https://epoc.devfasttrack.com/
# DATABASE_URL=postgresql://user:password@host:5432/eproc_fsa_cls

# Global tenant control-plane: admin identities, tenant configuration, Terraform
# jobs and tenant audit events only. Local default: data/control-plane.db.
# In production CONTROL_DATABASE_URL is mandatory and never falls back to DATABASE_URL.
# CONTROL_DATABASE_URL=postgresql://user:password@host:5432/eproc_control
# CONTROL_SQLITE_PATH=data/control-plane.db
# CONTROL_DB_POOL_MAX=5

# Tenant operational issue log-plane. This does not store candidate violations.
# In production LOG_DATABASE_URL is mandatory and must be separate from both URLs above.
# Local default: data/tenant-logs.db.
# LOG_DATABASE_URL=postgresql://user:password@host:5432/eproc_fsa_cls_logs
# LOG_SQLITE_PATH=data/tenant-logs.db
# LOG_DB_POOL_MAX=5

# Comma-separated Secrets Manager ARN allowlist readable by the superadmin control-plane
# host for selected remote tenant log observation. Do not set this on ordinary tenant hosts.
# CONTROL_PLANE_LOG_SECRET_ARNS=arn:aws:secretsmanager:ap-southeast-1:123456789012:secret:eproc-acme

# Initial platform owner (used only when admin_users is empty).
SUPERADMIN_USERNAME=supperadmin
SUPERADMIN_PASSWORD=change-this-before-first-production-start

# Multi-tenant Terraform control plane. Keep disabled on developer machines and
# serverless deployments. Enable only on a trusted, persistent admin worker/host.
TENANT_PROVISIONING_ENABLED=false
TERRAFORM_BIN=terraform
TERRAFORM_STATE_BUCKET=eproc-terraform-state
TERRAFORM_STATE_REGION=ap-southeast-1
TERRAFORM_LOCK_TABLE=eproc-terraform-locks
# TENANT_TERRAFORM_WORKDIR=/opt/eproc/tenant-terraform

# Platform-owned compiler image. Required only when an approved tenant enables
# the Practice Lambda compiler; tenants cannot override this image.
# TENANT_COMPILER_IMAGE_URI=123456789012.dkr.ecr.ap-southeast-1.amazonaws.com/eproc/compiler:v1

# These are written automatically by Terraform on each tenant server.
PRACTICE_COMPILER_MODE=local
# PRACTICE_COMPILER_LAMBDA_ARN=arn:aws:lambda:ap-southeast-1:123456789012:function:eproc-example-compiler
