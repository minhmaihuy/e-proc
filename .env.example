NODE_ENV=development
PORT=3001
JWT_SECRET=replace-with-at-least-32-random-characters
SESSION_SECRET=replace-with-another-random-secret
ALLOWED_ORIGINS=http://localhost:5173

# Leave DATABASE_URL empty for local SQLite development.
# DATABASE_URL=postgresql://user:password@host:5432/eproc

# Initial platform owner (used only when admin_users is empty).
SUPERADMIN_USERNAME=supperadmin
SUPERADMIN_PASSWORD=change-this-before-first-production-start

# Multi-tenant Terraform control plane. Keep disabled on developer machines and
# serverless deployments. Enable only on a trusted, persistent admin worker/host.
TENANT_PROVISIONING_ENABLED=false
TERRAFORM_BIN=terraform
TERRAFORM_STATE_BUCKET=eproc-terraform-state
TERRAFORM_STATE_REGION=ap-southeast-1
TERRAFORM_LOCK_TABLE=eproc-terraform-locks
# TENANT_TERRAFORM_WORKDIR=/opt/eproc/tenant-terraform

# Platform-owned compiler image. Required only when an approved tenant enables
# the Practice Lambda compiler; tenants cannot override this image.
# TENANT_COMPILER_IMAGE_URI=123456789012.dkr.ecr.ap-southeast-1.amazonaws.com/eproc/compiler:v1

# These are written automatically by Terraform on each tenant server.
PRACTICE_COMPILER_MODE=local
# PRACTICE_COMPILER_LAMBDA_ARN=arn:aws:lambda:ap-southeast-1:123456789012:function:eproc-example-compiler
