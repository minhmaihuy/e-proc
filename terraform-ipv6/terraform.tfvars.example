# =============================================================================
# E-Audit IPv6 Environment — Variables
# DO NOT commit this file to Git! (contains secrets)
# =============================================================================

# AWS Region (Singapore for lowest latency from Vietnam)
aws_region = "ap-southeast-1"

# Domain
domain_name   = "devfatstrack.cloud"
app_subdomain = "epoc" # Final FSA-CLS URL: https://epoc.devfatstrack.cloud

# EC2
instance_type         = "t3.micro"
allowed_ssh_ipv6_cidr = "::/0" # Keep "::/0" for anywhere, or restrict to your home IPv6

# RDS PostgreSQL — Multitenant: 3 separate databases on same RDS instance
db_instance_class = "db.t3.micro" # Free Tier eligible
db_username       = "eaudit_admin"
db_password       = "Minhmh123#!2nf"

# Assessment data-plane (exam data, questions, submissions, AI queue)
db_name = "eaudit"

# Global control-plane (tenant management, admin accounts)
control_db_name = "eaudit_control"

# Per-tenant operational log-plane
log_db_name = "eaudit_fsa_cls_logs"

# Tenant slug identifier (must match TENANT_SLUG in backend)
tenant_slug = "fsa-cls"

# Google Gemini AI API Key (Get from: https://aistudio.google.com/app/apikey)
gemini_api_key = "AIzaSy..."

# Session Secret (random secure string, at least 32 characters)
# File nay DUOC TRACK trong git — chi de placeholder, dat gia tri that o
# terraform.tfvars (da gitignore). Sinh bang: openssl rand -hex 32
session_secret = "REPLACE_WITH_RANDOM_64_HEX_CHARS"

# Ky JWT admin/hoc vien. BAT BUOC, khong co default: thieu thi server thoat ngay
# luc khoi dong. Sinh bang: openssl rand -hex 32
jwt_secret = "REPLACE_WITH_RANDOM_64_HEX_CHARS"

# Database dung khi tao cac database con thieu (npm run db:ensure).
# Vai tro deploy can quyen CONNECT va CREATEDB tren database nay.
database_maintenance_db = "postgres"

# App Config
node_env = "production"
app_port = 3001
